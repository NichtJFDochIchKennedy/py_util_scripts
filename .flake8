[flake8]
# Configuration for Flake8 linter
# Ignore E203: whitespace before ':' - conflicts with Black formatter
# Ignore W503: line break before binary operator - conflicts with Black formatter
ignore = E203, W503
max-line-length = 120
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    .pytest_cache,
    .mypy_cache,
    build,
    dist

# Per-file ignores
per-file-ignores =
    __init__.py: F401
